<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is always dark (Claro ink background), in both light and dark system modes. -->
    <!-- Theme applied to the Android window while the app process is starting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied once Flutter is running, behind Flutter's own UI. Ink, not
         white, so nothing light flashes during start-up or screen changes. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/claro_ink</item>
    </style>
</resources>
